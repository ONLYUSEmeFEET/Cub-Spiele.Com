{
  "name": "cub-spiele-com-emulator",
  "private": true,
  "version": "1.5.0",
  "description": "Cub Spiele.Com — Cycle-Accurate Sharp SM8521 (Tiger Game.Com) Handheld Emulator for Windows, macOS, Linux, Android & Web with Competitive Hardcore Mode, Online Leaderboards, Multi-Player High Score Vault & RetroAchievements Integration",
  "keywords": [
    "emulator",
    "gamecom",
    "tiger-game-com",
    "sm8521",
    "sharp-sm8521",
    "retroachievements",
    "rcheevos",
    "hardcore-mode",
    "online-leaderboards",
    "high-scores",
    "handheld-emulator",
    "retro-gaming",
    "nvram",
    "stn-lcd",
    "typescript",
    "electron",
    "windows-x64",
    "macos",
    "linux",
    "android",
    "cross-platform",
    "cub-spiele-com"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ONLYUSEmeFEET/Cub-Spiele.Com.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "release:win": "vite build && python scripts/build-windows-release.py",
    "release:all": "vite build && python scripts/build-windows-release.py",
    "github:sync": "python scripts/github-sync.py",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:mac": "vite build && electron-builder --mac --universal",
    "dist:linux": "vite build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.cubspiele.emulator",
    "productName": "Cub Spiele.Com",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/assets/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": ["AppImage", "tar.gz", "deb"],
      "icon": "public/assets/icon-512.png",
      "category": "Game;Emulator;"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
